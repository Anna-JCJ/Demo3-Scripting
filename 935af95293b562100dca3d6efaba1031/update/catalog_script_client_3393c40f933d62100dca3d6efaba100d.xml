        <name>Parse Excel and Populate MRVS</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    if (newValue) {
        var ga = new GlideAjax('ImportExcelScript');
        ga.addParam('sysparm_name', 'importExcel');
        ga.addParam('sysparm_attachment_id', newValue);
        var mapper = [
            ['name', 'Name'],
            ['quantity', 'Quantity']
        ];
        ga.addParam('sysparm_attachment_mapper', JSON.stringify(mapper));
        ga.getXMLAnswer(setData);
    }

    function setData(response) {
        var data = JSON.parse(response);
        g_form.setValue('office_supplies_request_list', JSON.stringify(data));
    }
}]]></script>
