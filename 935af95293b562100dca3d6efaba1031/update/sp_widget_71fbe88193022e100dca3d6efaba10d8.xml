        <name>Knowledge Recently Updated</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
  data.title = options.title || "Recently Updated Articles";
  data.articles = [];
  
  var kbGr = new GlideRecord('kb_knowledge');
  kbGr.addActiveQuery();
  kbGr.addQuery('workflow_state', 'published');
  kbGr.orderByDesc('sys_updated_on');
  kbGr.setLimit(options.limit || 5);
  kbGr.query();
  
  while (kbGr.next()) {
    var article = {
      title: kbGr.getDisplayValue('short_description'),
      url: '?id=kb_article&sys_id=' + kbGr.getUniqueValue(),
      updated: kbGr.getDisplayValue('sys_updated_on')
    };
    data.articles.push(article);
  }
})();]]></script>
